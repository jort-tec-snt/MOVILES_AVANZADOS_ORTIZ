                                                                    <textField borderStyle="none" placeholder="Ej. 2" clearButtonMode="whileEditing" translatesAutoresizingMaskIntoConstraints="NO" id="field-quantity"><color key="backgroundColor" red="0.188" green="0.227" blue="0.251" alpha="1" colorSpace="custom" customColorSpace="sRGB"/><color key="textColor" red="0.961" green="0.945" blue="0.910" alpha="1" colorSpace="custom" customColorSpace="sRGB"/><constraints><constraint firstAttribute="height" constant="48" id="height-quantity"/></constraints><fontDescription key="fontDescription" type="system" pointSize="16"/><textInputTraits key="textInputTraits" keyboardType="numberPad"/></textField>
